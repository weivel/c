# Defines read_tokens(text result literals [count]), which reads a C source as the checks under test/ need it.

# Sets `${result}` to the tokens of `text`, each between two spaces: identifiers and `##`; and `${literals}` to each
# string the source spells, as the compiler would hand it to the program: a run of adjacent string literals joined
# into one, an identifier stringized by `#` joined onto the run it stands next to, and a run of character literals
# separated by commas, as an array initialiser spells a name, read as one string. Comments are matched whole and
# dropped, and a `#` that begins a line begins a directive, never a stringizing. With a fourth argument, `${count}` is
# set to how many strings were read, the empty ones included.
function(read_tokens text result literals)
    string(REGEX REPLACE "[][;]" " " text "\n${text}")
    string(REGEX REPLACE "\n[ \t]*#" "\n`" text "${text}")
    set(block_comment "/\\*([^*]|\\*+[^*/])*\\*+/")
    set(line_comment "//[^\n]*")
    set(string_literal "\"([^\"\\\\\n]|\\\\.)*\"")
    set(character_literal "'([^'\\\\\n]|\\\\.)*'")
    string(REGEX MATCHALL
        "${block_comment}|${line_comment}|${string_literal}|${character_literal}|[A-Za-z_][A-Za-z0-9_]*|##|[^ \t\r\n]"
        matched "${text}")
    set(state_tokens "")
    set(state_strings "")
    set(state_count 0)
    set(state_joined "")
    set(state_kind "")
    foreach(token IN LISTS matched)
        if(NOT state_kind STREQUAL "")
            read_one_token()
        elseif(token MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
            string(APPEND state_tokens " ${token} ")
        elseif(token MATCHES "^[\"'#]")
            read_one_token()
        endif()
    endforeach()
    end_the_string()
    set(${result} " ${state_tokens} " PARENT_SCOPE)
    set(${literals} "${state_strings}" PARENT_SCOPE)
    if(ARGC GREATER 3)
        set(${ARGV3} ${state_count} PARENT_SCOPE)
    endif()
endfunction()

# The character a character literal's text between its quotes stands for, as far as a name is concerned: an escape
# that is no printable character stands for nothing.
function(character_of inner result)
    if(inner MATCHES "^\\\\(.)")
        if(CMAKE_MATCH_1 MATCHES "^[\\\\'\"?]$")
            set(${result} "${CMAKE_MATCH_1}" PARENT_SCOPE)
        else()
            set(${result} "" PARENT_SCOPE)
        endif()
    else()
        set(${result} "${inner}" PARENT_SCOPE)
    endif()
endfunction()

# Ends the string being joined, if any. `state_kind` is what is being joined: `string` for string literals and the
# identifiers stringized onto them, `characters` for character literals, `string#` and `#` right after a `#` that
# follows a string and one that follows none.
macro(end_the_string)
    if(state_kind STREQUAL "string#")
        set(state_kind "string")
    endif()
    if(state_kind STREQUAL "string" OR state_kind STREQUAL "characters")
        list(APPEND state_strings "${state_joined}")
        math(EXPR state_count "${state_count} + 1")
    endif()
    set(state_joined "")
    set(state_kind "")
endmacro()

macro(read_a_string_literal)
    if(state_kind STREQUAL "characters")
        end_the_string()
    endif()
    string(APPEND state_joined "${CMAKE_MATCH_1}")
    set(state_kind "string")
endmacro()

macro(read_a_character_literal)
    if(NOT state_kind STREQUAL "characters")
        end_the_string()
    endif()
    character_of("${CMAKE_MATCH_1}" character)
    string(APPEND state_joined "${character}")
    set(state_kind "characters")
endmacro()

macro(read_a_stringizing)
    if(state_kind STREQUAL "string")
        set(state_kind "string#")
    else()
        end_the_string()
        set(state_kind "#")
    endif()
endmacro()

macro(read_a_plain_token)
    if(state_kind MATCHES "#$" AND token MATCHES "^[A-Za-z_][A-Za-z0-9_]*$")
        string(APPEND state_joined "${token}")
        set(state_kind "string")
    else()
        end_the_string()
    endif()
    if(token MATCHES "^([A-Za-z_][A-Za-z0-9_]*|##)$")
        string(APPEND state_tokens " ${token} ")
    endif()
endmacro()

# Reads the loop's `token` into read_tokens' state.
macro(read_one_token)
    if(token MATCHES "^\"(.*)\"$")
        read_a_string_literal()
    elseif(token MATCHES "^'(.*)'$")
        read_a_character_literal()
    elseif(token STREQUAL "," AND state_kind STREQUAL "characters")
    elseif(token STREQUAL "#")
        read_a_stringizing()
    elseif(NOT token MATCHES "^(/\\*|//)")
        read_a_plain_token()
    endif()
endmacro()
